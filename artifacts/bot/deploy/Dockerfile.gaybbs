# syntax=docker/dockerfile:1.7
# Build only the existing @GayBBS_bot. Do not change Gserver Core/Storage.
# This linux/amd64 Node 22 Alpine base digest comes from the adopted Gserver
# pinned VideoBot integration contract; verify host architecture at deployment.
ARG NODE_IMAGE=node@sha256:025b8e975a61d94e33abeafaad1255ef44e4898cf1a1b6446860009c72e6d284
FROM ${NODE_IMAGE} AS build
WORKDIR /src
RUN corepack enable && corepack prepare pnpm@10.16.1 --activate
COPY . .
RUN pnpm install --frozen-lockfile --filter '@workspace/bot...'
RUN pnpm --dir artifacts/bot run build:gaybbs
RUN node --check artifacts/bot/dist/gaybbs.mjs

FROM ${NODE_IMAGE} AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=node:node /src/artifacts/bot/dist/gaybbs.mjs /app/gaybbs.mjs
COPY --from=build --chown=node:node /src/artifacts/bot/dist/publishMenuPanels.mjs /app/publishMenuPanels.mjs
COPY --from=build --chown=node:node /src/artifacts/bot/dist/recordPhaseADmEvidence.mjs /app/recordPhaseADmEvidence.mjs
COPY --from=build --chown=node:node /src/artifacts/bot/dist/publishTopicBoards.mjs /app/publishTopicBoards.mjs
COPY --from=build --chown=node:node /src/artifacts/bot/deploy/topic-board-ledger-v1.json /app/topic-board-ledger-v1.json
# undici preload: Node fetch in Docker/WSL must prefer IPv4 for api.telegram.org
USER root
RUN npm install --omit=dev undici@6.21.3
RUN mkdir -p /app/preload && printf '%s\n' \
  '/** Prefer IPv4 for Telegram Bot API in Docker/WSL (undici dual-stack hang). */' \
  'import { Agent, setGlobalDispatcher } from "undici";' \
  'setGlobalDispatcher(new Agent({ connect: { family: 4, timeout: 20_000 } }));' \
  > /app/preload/telegram-ipv4-preload.mjs
RUN chown -R node:node /app
USER node
# Runtime requires separately supplied BOT_TOKEN_FILE and DATABASE_URL.
# No real Bot is started by building the image.
CMD ["node", "--import", "/app/preload/telegram-ipv4-preload.mjs", "/app/gaybbs.mjs"]
