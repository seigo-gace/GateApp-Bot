[Unit]
Description=G-ACE Telegram Userbot verification account (persistent login, no SMS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/gace/Project/Gserver/projects/TGtumbler/GateApp-Bot
ExecStart=/home/gace/Project/Gserver/projects/TGtumbler/GateApp-Bot/deploy/.userbot-venv/bin/python -u /home/gace/Project/Gserver/projects/TGtumbler/GateApp-Bot/scripts/userbot_keepalive.py
Restart=on-failure
RestartSec=15s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/gace/Project/Gserver/projects/TGtumbler/GateApp-Bot/deploy/secrets

[Install]
WantedBy=default.target
